 "info": {
  "title": "EICViBE lattice viewer",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/v1/engines": {
   "get": {
    "description": "Physics engines that can compute optics here.",
    "operationId": "engines_api_v1_engines_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/EngineInfo"
         },
         "title": "Response Engines Api V1 Engines Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Engines"
   }
  },
  "/api/v1/health": {
   "get": {
    "operationId": "health_api_v1_health_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": {
          "type": "string"
         },
         "title": "Response Health Api V1 Health Get",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Health"
   }
  },
  "/api/v1/lattices": {
   "get": {
    "description": "Lattices this server offers, at their current revisions.",
    "operationId": "lattices_api_v1_lattices_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/LatticeEntry"
         },
         "title": "Response Lattices Api V1 Lattices Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Lattices"
   }
  },
  "/api/v1/lattices/{digest}": {
   "get": {
    "description": "Branches, forks, floor closures, shared components and diagnostics of a revision.",
    "operationId": "lattice_api_v1_lattices__digest__get",
    "parameters": [
     {
      "in": "path",
      "name": "digest",
      "required": true,
      "schema": {
       "title": "Digest",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/LatticeSummary"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Lattice"
   }
  },
  "/api/v1/lattices/{digest}/branches/{branch}": {
   "get": {
    "description": "Element table and floor coordinates of one branch (by id or name).",
    "operationId": "branch_api_v1_lattices__digest__branches__branch__get",
    "parameters": [
     {
      "in": "path",
      "name": "digest",
      "required": true,
      "schema": {
       "title": "Digest",
       "type": "string"
      }
     },
     {
      "in": "path",
      "name": "branch",
      "required": true,
      "schema": {
       "title": "Branch",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BranchData"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Branch"
   }
  },
  "/api/v1/lattices/{digest}/branches/{branch}/optics": {
   "get": {
    "description": "Design optics of one branch: beta functions, dispersion, phase advance, orbit, tunes, chromaticity.\n\nThe first request for a revision computes the whole machine (lines start from the\noptics at their forks), which can take a while: TrackPad starts Julia on first use.",
    "operationId": "branch_optics_api_v1_lattices__digest__branches__branch__optics_get",
    "parameters": [
     {
      "in": "path",
      "name": "digest",
      "required": true,
      "schema": {
       "title": "Digest",
       "type": "string"
      }
     },
     {
      "in": "path",
      "name": "branch",
      "required": true,
      "schema": {
       "title": "Branch",
       "type": "string"
      }
     },
     {
      "description": "Engine name; see /engines",
      "in": "query",
      "name": "engine",
      "required": false,
      "schema": {
       "default": "xsuite",
       "description": "Engine name; see /engines",
       "title": "Engine",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "fidelity",
      "required": false,
      "schema": {
       "$ref": "#/components/schemas/Fidelity",
       "default": "standard"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BranchOptics"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Branch Optics"
   }
  },
  "/api/v1/lattices/{digest}/lattice.json": {
   "get": {
    "description": "The revision itself, in canonical JSON, to open with ``Lattice.from_json``.",
    "operationId": "download_api_v1_lattices__digest__lattice_json_get",
    "parameters": [
     {
      "in": "path",
      "name": "digest",
      "required": true,
      "schema": {
       "title": "Digest",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Download"
   }
  },
  "/api/v1/lattices/{digest}/occurrences/{occurrence}": {
   "get": {
    "description": "Parameters, floor pose, fork, shared component and devices of one occurrence.",
    "operationId": "occurrence_api_v1_lattices__digest__occurrences__occurrence__get",
    "parameters": [
     {
      "in": "path",
      "name": "digest",
      "required": true,
      "schema": {
       "title": "Digest",
       "type": "string"
      }
     },
     {
      "in": "path",
      "name": "occurrence",
      "required": true,
      "schema": {
       "title": "Occurrence",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/OccurrenceDetail"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Occurrence"
   }
  }
 }
}
