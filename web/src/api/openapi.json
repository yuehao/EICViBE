   "BranchTable": {
    "description": "Per-occurrence values in beam order, one list per field.\n\n``Kn1`` and ``Kn1L`` (and the same for ``Kn2``) combine both ways a lattice\ncan give a strength: ``Kn1L = Kn1 * length + Kn1L`` and, for an element\nwith length, ``Kn1 = Kn1L / length``. A value is null where it does not\napply to the element's kind.",
    "properties": {
     "columns": {
      "items": {
       "$ref": "#/components/schemas/Column"
      },
      "title": "Columns",
      "type": "array"
     },
     "component": {
      "description": "Shared component an occurrence is a traversal of",
