       "type": "string"
      },
      "title": "Id",
      "type": "array"
     },
     "kind": {
      "items": {
       "type": "string"
      },
      "title": "Kind",
      "type": "array"
     },
     "length": {
      "items": {
       "type": "number"
      },
      "title": "Length",
      "type": "array"
     },
     "name": {
      "description": "Lattice (design) name of the occurrence",
      "items": {
       "type": "string"
      },
      "title": "Name",
      "type": "array"
     },
     "s": {
      "description": "s at the entrance, m",
