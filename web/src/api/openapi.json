     "id": {
      "items": {
       "type": "string"
      },
      "title": "Id",
      "type": "array"
     },
     "kind": {
      "items": {
       "type": "string"
      },
      "title": "Kind",
      "type": "array"
     },
     "length": {
      "items": {
       "type": "number"
      },
      "title": "Length",
      "type": "array"
     },
     "name": {
      "items": {
       "type": "string"
      },
      "title": "Name",
      "type": "array"
     },
     "s": {
      "description": "s at the entrance, m",
      "items": {
       "type": "number"
      },
      "title": "S",
      "type": "array"
     },
     "values": {
      "additionalProperties": {
       "items": {
        "anyOf": [
         {
          "type": "number"
