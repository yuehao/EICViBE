        },
        {
         "type": "null"
        }
       ]
      },
      "title": "Device",
      "type": "array"
     },
     "element": {
      "description": "Name of the placed element definition",
      "items": {
       "type": "string"
      },
      "title": "Element",
      "type": "array"
     },
     "fork_to": {
      "description": "Branch a fork leads to",
