       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": "Device",
      "type": "array"
     },
     "eic_name": {
      "description": "EIC name (EIC-SEG-RSI-009) of the element, from the machine registry; null without one",
